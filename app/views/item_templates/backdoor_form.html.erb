<h1>Add a new item</h1>

<form action="/make_a_new_item" method="post">
  <div>
    <label for="linkurl">Link URL</label>
    <input id="linkurl" type="text" name="link_url_param">
  </div>

  <div>
    <label for="descrip">Link Description</label>
    <input id="descrip" type="text" name="link_description_param">
  </div>

  <div>
    <label for="thumby">Thumbnail URL</label>
    <input id="thumby" type="text" name="thumbnail_url_param">
  </div>

<button>Create item</button type = "submit">

</form>


